                <mxCell id="s1" value="&lt;b&gt;RESERVED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;已生效 · 待开始&lt;br&gt;参与冲突判定（有效预约）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;strokeWidth=2;strokeColor=#8974A8;fillColor=#F1EBF7;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#503B70;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
