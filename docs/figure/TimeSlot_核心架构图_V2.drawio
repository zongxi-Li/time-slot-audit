                <mxCell id="C1" value="&lt;b&gt;此刻数据库中该时段尚无有效预约&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;前端快照仅作交互参考，不能作为业务判定依据&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;strokeWidth=2;strokeColor=#9AAEBD;fillColor=#F8FAFC;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#455F73;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="520" y="200" width="560" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="B1" value="&lt;b&gt;t1 · 查看日历&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A301 · 10:00—11:00 同样显示为空闲&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeWidth=2;strokeColor=#8974A8;fillColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#503B70;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1170" y="200" width="340" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="A2" value="&lt;b&gt;t2 · 提交预约&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;POST /api/reservations（request_id = req-A）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeWidth=2;strokeColor=#5B93C2;fillColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#315B7F;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="90" y="330" width="340" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="C2" value="&lt;b&gt;t2 · A 事务开启并获得行锁&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;BEGIN → SELECT room … FOR UPDATE（A301 行锁 ✔）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeWidth=2;strokeColor=#B9824A;fillColor=#FFF8ED;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#735126;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="520" y="330" width="560" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="B2" value="&lt;b&gt;t2 · 提交预约&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;POST /api/reservations（request_id = req-B）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeWidth=2;strokeColor=#8974A8;fillColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#503B70;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1170" y="330" width="340" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="C3" value="&lt;b&gt;t3 · B 事务开启 → 请求同一把行锁 → 阻塞等待&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;并发事务在锁上串行，检查与写入不会交错（CON-03）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeWidth=2;strokeColor=#C08A52;fillColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#735126;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="520" y="470" width="560" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="A3" value="等待响应（loading）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;strokeColor=#C7D2DC;fillColor=#FBFCFD;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#6B8299;" parent="1" vertex="1">
                    <mxGeometry x="90" y="490" width="340" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="B3" value="等待响应（loading）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;strokeColor=#C7D2DC;fillColor=#FBFCFD;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#6B8299;" parent="1" vertex="1">
                    <mxGeometry x="1170" y="490" width="340" height="50" as="geometry"/>
