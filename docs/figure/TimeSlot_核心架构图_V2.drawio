                </mxCell>
                <mxCell id="result" value="&lt;b&gt;最终结果（CON-01 满足）&lt;/b&gt;　数据库中仅存在 A 的有效预约；B 的请求被安全拒绝且不留半完成记录；重复的 request_id 幂等返回首次结果" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;strokeWidth=2;strokeColor=#9AAEBD;fillColor=#F8FAFC;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#455F73;spacing=10;align=center;verticalAlign=middle;" parent="1" vertex="1">
