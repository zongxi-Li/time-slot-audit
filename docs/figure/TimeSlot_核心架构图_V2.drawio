                </mxCell>
                <mxCell id="C5" value="&lt;b&gt;t5 · B 获得锁 → 锁内二次校验：发现与 A 重叠 → ROLLBACK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;newStart &amp;lt; oldEnd 且 newEnd &amp;gt; oldStart 命中 → 回滚并释放锁（CON-04）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeWidth=2;strokeColor=#C47D7D;fillColor=#FFF7F6;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#784A4A;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
