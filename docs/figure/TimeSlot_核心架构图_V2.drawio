                <mxCell id="A4" value="&lt;b&gt;t4 · HTTP 201 Created ✔&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;预约成功 · 日历刷新显示预约块&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeWidth=2;strokeColor=#418E85;fillColor=#EAF7F5;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#285F58;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="90" y="610" width="340" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="C4" value="&lt;b&gt;t4 · A 锁内二次校验：无重叠 → INSERT → COMMIT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;重叠 SQL 未命中 → 写入预约 → 提交并释放行锁&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeWidth=2;strokeColor=#B9824A;fillColor=#FFF8ED;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#735126;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="520" y="610" width="560" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="B4" value="仍阻塞等待行锁…" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;strokeColor=#C7D2DC;fillColor=#FBFCFD;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#6B8299;" parent="1" vertex="1">
