                <mxCell id="end" value="历史可溯" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#4E8992;fillColor=#E7F4F5;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;fontColor=#315F65;" parent="1" vertex="1">
                    <mxGeometry x="1330" y="432" width="90" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="s4" value="&lt;b&gt;CANCELLED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;已取消 · 终态&lt;br&gt;保留审计 · 不占用时间资源&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;strokeWidth=2;strokeColor=#C47D7D;fillColor=#FFF7F6;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#784A4A;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="620" y="650" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="&lt;b&gt;有效预约 = RESERVED / IN_USE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;二者参与时间冲突判定&lt;br&gt;CANCELLED 不参与（BR-06）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;strokeWidth=2;strokeColor=#9AAEBD;fillColor=#F8FAFC;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#455F73;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
